rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net: Default-deny all operations
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'email'])
        && data.uid is string && data.uid.size() <= 128
        && data.email is string && data.email.size() <= 256
        && data.uid == request.auth.uid
        && (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 128))
        && (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 512));
    }

    function isValidCalculation(data) {
      return data.keys().hasAll(['userId', 'customerName', 'projectName', 'currency', 'propertyPrice', 'monthlyPayment'])
        && data.userId is string && data.userId.size() <= 128
        && data.userId == request.auth.uid
        && data.customerName is string && data.customerName.size() <= 128
        && data.projectName is string && data.projectName.size() <= 128
        && data.currency in ['LAK', 'THB', 'USD']
        && data.propertyPrice is number && data.propertyPrice >= 0
        && data.monthlyPayment is number && data.monthlyPayment >= 0
        && (!('agentPhone' in data) || (data.agentPhone is string && data.agentPhone.size() <= 64))
        && (!('notes' in data) || (data.notes is string && data.notes.size() <= 1000));
    }

    // User Profile: Strict PII Isolation - only owner can read and write
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create, update: if isOwner(userId) && isValidId(userId) && isValidUserProfile(incoming());
      allow delete: if false;
    }

    // Saved Calculations: Full access only for document owner
    match /calculations/{calcId} {
      allow get: if isSignedIn() && isValidId(calcId) && existing().userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isVerified() && isValidId(calcId) && isValidCalculation(incoming());
      allow update: if isVerified() && isValidId(calcId) 
                    && existing().userId == request.auth.uid 
                    && incoming().userId == request.auth.uid 
                    && isValidCalculation(incoming());
      allow delete: if isSignedIn() && isValidId(calcId) && existing().userId == request.auth.uid;
    }
  }
}
